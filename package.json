{
  "name": "rewelo",
  "version": "0.6.1",
  "description": "Prioritisation tool using the relative weight method with SQLite",
  "bin": {
    "rw": "dist/index.js"
  },
  "scripts": {
    "build": "node scripts/inject-version.mjs && tsc",
    "prepack": "npm run build",
    "site": "node site/build.mjs",
    "test": "node --test --enable-source-maps \"build/test/**/*.test.js\"",
    "start": "node dist/index.js",
    "pretest": "node scripts/inject-version.mjs && tsc -p tsconfig.test.json && node -e \"require('node:fs').cpSync('db', 'build/db', { recursive: true })\""
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "db/create.sql",
    "db/model.dbml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "prioritization",
    "backlog",
    "relative-weight",
    "sqlite",
    "mcp",
    "cli"
  ],
  "author": "Sebastian Schürmann",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebs/rewelo.git"
  },
  "homepage": "https://sebs.github.io/rewelo/",
  "bugs": {
    "url": "https://github.com/sebs/rewelo/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "commander": "^15.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
