{
  "name": "rewelo",
  "version": "0.4.2",
  "description": "Prioritisation tool using the relative weight method with SQLite",
  "main": "dist/index.js",
  "bin": {
    "rw": "dist/index.js"
  },
  "scripts": {
    "build": "node scripts/inject-version.mjs && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js"
  },
  "files": [
    "dist/",
    "db/create.sql",
    "db/model.dbml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "prioritization",
    "backlog",
    "relative-weight",
    "sqlite",
    "mcp",
    "cli"
  ],
  "author": "Sebastian Schürmann",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "commander": "^15.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
